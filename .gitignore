.DS_Store
.idea/*
!.idea/modules.xml
!.idea/chumicro.iml
!.idea/runConfigurations/
!.idea/inspectionProfiles/
.venv/
.tools/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
site/
.site/
*.egg-info/

# Generated by docs build from support/docs/ and zensical
libraries/*/docs/stylesheets/
libraries/*/docs/img/
libraries/*/docs/assets/
workbench/*/docs/stylesheets/
workbench/*/docs/img/
workbench/*/docs/assets/

.mypy_cache/
.scratch/
.claude/
devices.yml

# Legacy: chumicro-dev-config.toml.  Retired in Phase 4 of the unification
# workstream — networking-library functional-test conftests now read from
# workspace.yml + workspace.local.yml via `chumicro_workspace.compose_runtime_config`.
# Kept gitignored for one cycle so contributors with a left-over copy from
# the pre-Phase-4 era don't accidentally commit it.
chumicro-dev-config.toml

# Legacy: secrets.yml + !secret marker.  Retired in Decision 0057 — credentials
# now live in workspace.local.yml as a structural overlay deep-merged on top
# of workspace.yml.  Kept gitignored so contributors with a left-over copy
# from the pre-0057 era don't accidentally commit it.
secrets.yml

# Gitignored credential / per-developer overlay (Decision 0057).  Same
# section-namespaced shape as workspace.yml; deep-merged on top so any key
# set here wins.  Materialised by `python scripts/run.py setup` from
# chumicro-workspace's _payloads/.  Never committed — contains real wifi
# passwords / broker auth.
workspace.local.yml

# Per-project gitignored override (Decision 0057, optional).  Same shape as
# the project's config.toml/.yml; deep-merged on top so per-project secret
# overrides don't leak into git.
projects/**/config.local.toml
projects/**/config.local.yml
projects/**/config.local.yaml
libraries/*/functional_tests/config.local.toml
libraries/*/functional_tests/config.local.yml
libraries/*/functional_tests/config.local.yaml

# Per-test wifi credentials shim — generated by each library's
# functional_tests/conftest.py from compose_runtime_config(), staged
# alongside the test on the device, never committed.
**/_test_creds.py

