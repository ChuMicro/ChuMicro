# Legacy: chumicro-dev-config.toml.  Retired in Phase 4 of the unification
# workstream — networking-library functional-test conftests now read from
# workspace.yml + secrets.yml via `chumicro_workspace.compose_runtime_config`.
# Kept gitignored for one cycle so contributors with a left-over copy from
# the pre-Phase-4 era don't accidentally commit it.
chumicro-dev-config.toml

# Gitignored credential store — referenced from workspace.yml and per-library
# functional_tests/config.toml via `!secret <name>`.  Materialised by
# `python scripts/run.py setup` from chumicro-workspace's _payloads/.
# Never committed — contains real wifi passwords / api tokens.
secrets.yml

# Per-test wifi credentials shim — generated by each library's
# functional_tests/conftest.py from chumicro-dev-config.toml, staged
# alongside the test on the device, never committed.
**/_test_creds.py

