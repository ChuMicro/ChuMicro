.DS_Store
.idea/*
!.idea/modules.xml
!.idea/runConfigurations/
!.idea/inspectionProfiles/
# .idea/chumicro.iml is generated by scripts/run.py sync-ide and is
# also live-edited by PyCharm while the project is open — committing
# it causes constant diff churn.  Contributors regenerate it by
# running ``python scripts/run.py sync-ide``, or by opening the
# project in PyCharm which auto-detects source roots from the per-
# package pyproject.toml files.
.venv/
.tools/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
site/
.site/
*.egg-info/

# Generated by docs build from support/docs/ and zensical
libraries/*/docs/stylesheets/
libraries/*/docs/img/
libraries/*/docs/assets/

.mypy_cache/
.scratch/
devices.yml
device-config.yml

