devices.yml

# Local-machine dev config for chumicro contributors — wifi creds for
# real-network functional tests, broker overrides, etc.  Materialised by
# `python scripts/run.py setup` from scripts/templates/.  Never committed.
# Phase 4 of `plans/workstreams/scripts-workbench-config-unification.md`
# retires this file in favour of the unified workspace.yml + secrets.yml.
chumicro-dev-config.toml

# Gitignored credential store — referenced from workspace.yml + per-library
# functional_tests/config.toml via `!secret <name>`.  Materialised by
# `python scripts/run.py setup` from chumicro-workspace's _payloads/.
# Phase 3 of the unification workstream introduced this file; Phase 4
# wires functional tests to read from workspace.yml + here.  Never
# committed — contains real wifi passwords / api tokens.
secrets.yml

# Per-test wifi credentials shim — generated by each library's
# functional_tests/conftest.py from chumicro-dev-config.toml, staged
# alongside the test on the device, never committed.
**/_test_creds.py

