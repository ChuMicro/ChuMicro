{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git --no-pager log --oneline -20)",
      "Bash(git --no-pager log --oneline -15)",
      "Bash(git --no-pager status)",
      "Bash(git --no-pager log --oneline -30)",
      "Read(//Volumes/**)",
      "Bash(diskutil list *)",
      "Bash(python scripts/run.py --help)",
      "Bash(python3 scripts/run.py --help)",
      "Bash(xargs ls *)",
      "Bash(system_profiler SPUSBDataType)",
      "Bash(curl *)",
      "Bash(brew list *)",
      "Bash(ioreg -p IOUSB -l -w 0)",
      "Bash(awk '/Product ID:/ {pid=$3} /Vendor ID:/ {print $3, \"/\", pid}')",
      "Bash(.venv/bin/chumicro-workspace*)",
      "Bash(.venv/bin/chumicro-deploy*)",
      "Bash(.venv/bin/chumicro-repl*)",
      "Bash(git push --force-with-lease*:*)"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/surfaces/ask_gate.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/surfaces/picker_edit_gate.py\""
          }
        ]
      }
    ]
  },
  "includeGitInstructions": false
}
