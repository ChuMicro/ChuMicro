[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{distribution}"
dynamic = ["version"]
# TODO: replace with a one-line description; rendered on the docs landing page
# and on PyPI. An empty value renders as an empty card.
description = ""
readme = "README.md"
requires-python = ">=3.11"
license = "MIT"
license-files = ["LICENSE"]
authors = [
    {{ name = "{author}" }},
]
keywords = [
    # Workbench tools run on the host (laptop), not on a board.  Tag with
    # the things they help you do.  Typical entries: "deploy", "serial",
    # "config", "workspace".
    "host", "workbench",
]
classifiers = [
    "Development Status :: 2 - Pre-Alpha",
    "Intended Audience :: Developers",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3 :: Only",
    "Topic :: Software Development :: Build Tools",
    "Operating System :: OS Independent",
]
dependencies = [
    # Workbench packages may freely depend on CPython-only third-party
    # libraries (pyserial, pyyaml, ruamel, rich, etc.) because workbench
    # packages are CPython-only.  Don't depend on the chumicro device
    # libraries; those are built for the board.
]

[project.optional-dependencies]
test = [
    "pytest",
]

{project_urls}[project.scripts]
# Workbench packages typically expose a CLI.  Wire the entry-point
# function here; argparse + dispatch live in src/{import_name}/cli.py.
{distribution} = "{import_name}.cli:main"

[tool.hatch.version]
path = "VERSION"
pattern = "(?P<version>\\S+)"

[tool.hatch.build.targets.sdist]
only-include = ["src/", "VERSION", "README.md"]
exclude = [".gitignore"]

[tool.hatch.build.targets.wheel]
packages = ["src/{import_name}"]
