"""{display_name}: basic usage.

Creates a {class_name}, then raises its value by one every second,
forever.  On a laptop, press Ctrl-C to stop it.

Runs on CPython, MicroPython, and CircuitPython.

Rewrite the script below for your real class, then update the Example
output block so it matches what the rewritten script actually prints.
Keep the ``while True:`` loop at the bottom, doing your class's real
work on each pass: a board runs its program until the power goes, so
an example never exits.

Example output::

    Created {display_name} with value=0
    Value: 1
    Value: 2
    Value: 3
"""

import time

from {import_name} import {class_name}

thing = {class_name}(value=0)
print(f"Created {display_name} with value={{thing.value}}")

while True:
    thing.update(thing.value + 1)
    print(f"Value: {{thing.value}}")
    time.sleep(1)
