# secrets.yml — gitignored credential store referenced via `!secret <name>`.
#
# 1. Copy this file to `secrets.yml` (NOT committed — covered by .gitignore).
# 2. Add your real credentials below as flat key/value pairs.
# 3. Reference them from any thing's config.toml as:
#
#        password = "!secret wifi_password"
#
#    The deploy-time merge resolves !secret refs against secrets.yml
#    before packing the runtime config msgpack — see Decision 0035 §6.

# wifi_password: replace-me
# api_token: replace-me
