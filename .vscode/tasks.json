{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Prepare Workspace",
            "type": "shell",
            "command": "python",
            "args": ["scripts/prepare_workspace.py"],
            "group": "build",
            "presentation": {"reveal": "always", "panel": "shared"}
        },
        {
            "label": "Preflight",
            "type": "shell",
            "command": "python",
            "args": ["ci/tasks.py", "preflight"],
            "group": {"kind": "build", "isDefault": true},
            "presentation": {"reveal": "always", "panel": "shared"}
        },
        {
            "label": "Lint",
            "type": "shell",
            "command": "python",
            "args": ["ci/tasks.py", "lint"],
            "group": "build",
            "presentation": {"reveal": "always", "panel": "shared"}
        },
        {
            "label": "Host Tests",
            "type": "shell",
            "command": "python",
            "args": ["ci/tasks.py", "test-host"],
            "group": "test",
            "presentation": {"reveal": "always", "panel": "shared"}
        },
        {
            "label": "Build Sample",
            "type": "shell",
            "command": "python",
            "args": ["ci/tasks.py", "build-sample"],
            "group": "build",
            "presentation": {"reveal": "always", "panel": "shared"}
        },
        {
            "label": "MicroPython Compat",
            "type": "shell",
            "command": "python",
            "args": ["ci/tasks.py", "test-micropython-compat"],
            "group": "test",
            "presentation": {"reveal": "always", "panel": "shared"}
        },
        {
            "label": "CircuitPython Compat",
            "type": "shell",
            "command": "python",
            "args": ["ci/tasks.py", "test-circuitpython-compat"],
            "group": "test",
            "presentation": {"reveal": "always", "panel": "shared"}
        },
        {
            "label": "Runtime Matrix",
            "type": "shell",
            "command": "python",
            "args": ["ci/tasks.py", "test-runtime-matrix"],
            "group": "test",
            "presentation": {"reveal": "always", "panel": "shared"}
        }
    ]
}
