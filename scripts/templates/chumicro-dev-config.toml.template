# chumicro-dev-config.toml — local dev config for chumicro contributors.
#
# Materialised by `python scripts/run.py setup` from
# scripts/templates/chumicro-dev-config.toml.template.  Edit freely;
# gitignored, never committed.
#
# Used only inside the chumicro mono-repo, by
# `libraries/*/functional_tests/test_real_*.py` — real-network
# acceptance tests skip silently when [wifi] is unconfigured.
#
# Examples + production code don't read this file.  They use the
# standard chumicro-config pipeline (runtime_config.msgpack baked from
# secrets.yml at deploy time by chumicro-workspace).  See
# `plans/decisions/0030-config-and-state.md` for the boundary.
#
# To enable a section: uncomment the keys and fill in real values.

# -- WiFi credentials ------------------------------------------------------
# Used by every functional test that needs a real AP (libraries/wifi,
# libraries/requests, libraries/http_server, libraries/mqtt).

# [wifi]
# ssid = "your-wifi-ssid"
# password = "your-wifi-password"

# -- MQTT broker -----------------------------------------------------------
# Optional override for libraries/mqtt/functional_tests/test_real_broker.py.
# When unset, the test defaults to test.mosquitto.org:1883 (public test
# broker, no auth, no TLS).  Point at your own broker for non-toy
# acceptance scenarios.

# [mqtt.broker]
# host = "test.mosquitto.org"
# port = 1883
