# Device registry for local/CI device testing.
#
# Fill in your board details below.
# This file is gitignored — it will not be committed.
#
# See Decision 0027 for the full schema.

# ── Global defaults ──────────────────────────────────────────────
# Controls which boards the IDE play button targets and the default
# deploy mode.  Change ide_runtime to "both" to run every functional
# test on both boards.
defaults:
  # Device IDs to use for each runtime (must match an id below).
  micropython: sample-micropython-board
  circuitpython: sample-circuitpython-board
  # Deploy mode for all devices: "ram" (no flash wear) or "flash".
  deploy_mode: ram
  # Which runtimes IDE play buttons target: micropython, circuitpython, or both.
  ide_runtime: micropython

# ── Device registry ──────────────────────────────────────────────
devices:
  - id: sample-circuitpython-board
    description: Example CircuitPython board entry for local device validation.
    runtime: circuitpython
    connection_type: serial
    address: /dev/cu.usbmodemEXAMPLE
    serial_baudrate: 115200
    setup_command: null
    # Override the global deploy_mode for this board (e.g. if RAM
    # testing is unreliable on this device):
    # deploy_mode: flash
    # Path to the CIRCUITPY USB drive mount point on the host.
    # Used for flash deploy mode.
    # OPTIONAL — leave this commented out.  chumicro-deploy probes
    # `microcontroller.cpu.uid` over raw REPL and matches it against
    # each mounted CIRCUITPY*/boot_out.txt UID line, so the right
    # drive is auto-selected even when macOS assigned `CIRCUITPY 1` /
    # `CIRCUITPY 2` in a different order this session.  Set this only
    # when UID matching can't disambiguate — two physically identical
    # boards connected at once, or a non-standard mount point.  If
    # set and wrong, chumicro-deploy auto-corrects and prints a
    # warning nudging you to remove the override.
    # circuitpy_drive_path: /Volumes/CIRCUITPY

  - id: sample-micropython-board
    description: Example MicroPython board entry for local device validation.
    runtime: micropython
    connection_type: serial
    address: /dev/cu.usbserial-EXAMPLE
    serial_baudrate: 115200
    setup_command: null
    # Override the global deploy_mode for this board:
    # deploy_mode: flash
